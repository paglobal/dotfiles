{
  "pre-tool-use-supervisor": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks.nu pre-tool-use",
            "timeout": 10800
          }
        ]
      }
    ]
  },
  "post-tool-use-supervisor": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks.nu post-tool-use",
            "timeout": 10800
          }
        ]
      }
    ]
  },
  "stoppage-alerter": {
    "Stop": [
      {
        "type": "command",
        "command": "./hooks.nu stop",
        "timeout": 300
      }
    ]
  },
  "post-invocation-officer": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "./hooks.nu post-invocation",
        "timeout": 300
      }
    ]
  }
}
