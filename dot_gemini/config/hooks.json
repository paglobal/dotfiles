{
  "tool-use-prompter": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command|manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "./hook-scripts/prompt-tool-use.nu"
          }
        ]
      }
    ]
  },
  "instruction-reinforcer": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hook-scripts/reinforce-instructions.nu"
      }
    ]
  }
}
