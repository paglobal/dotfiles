{
  "tool-use-supervisor": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/supervise-tool-use/supervise-tool-use.nu",
            "timeout": 10800
          }
        ]
      }
    ]
  },
  "instruction-reinforcer": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/reinforce-instructions/reinforce-instructions.nu"
      }
    ]
  }
}
